<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.OverviewFragment">

    <!-- TODO: Update blank fragment layout -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cardview_light_background"
        android:id="@+id/tb_overview"
        app:title="概览"/>

    <LinearLayout
        android:id="@+id/ll_mqtt_connection_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/tb_overview"
        android:background="@drawable/shape_layout_style">
        <TextView
            android:id="@+id/tv_mqtt_connection_status"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="连接云平台中"
            android:textSize="20sp"
            android:gravity="center" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_node1"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/ll_mqtt_connection_status">

        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="100dp"
            android:background="@drawable/shape_layout_style"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="温度："
                    android:textSize="25sp"/>
                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="——"
                    android:textSize="25sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="湿度："
                    android:textSize="25sp"/>
                <TextView
                    android:id="@+id/tv_humi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="——"
                    android:textSize="25sp"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="100dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/shape_layout_style"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="风扇："
                    android:textSize="25sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_fanctl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="加湿器："
                    android:textSize="25sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_humidifierctl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_autocontrol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/rl_node1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="自动调控："
            android:textSize="25sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_autocontrol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_node1_th_ctl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/ll_autocontrol"
        android:orientation="vertical"
        android:background="@drawable/shape_layout_style">

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/rs_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:valueFrom="16f"
            android:valueTo="26f"
            app:values="@array/range_slider_temp_values"
            android:stepSize="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="start"
                android:layout_marginStart="30dp"
                android:text="16"
                android:textSize="20sp"/>

            <!--关键是中间设置 layout_width="0dp" 和 layout_weight="1"：左右文字先占用所需宽度，中间再填充剩余空间，文字居中显示。-->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="温度调控"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:layout_marginEnd="30dp"
                android:text="26"
                android:textSize="20sp" />
        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/rs_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="15dp"
            android:valueFrom="0f"
            android:valueTo="90f"
            app:values="@array/range_slider_humi_values"
            android:stepSize="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="start"
                android:layout_marginStart="30dp"
                android:text="30"
                android:textSize="20sp"/>

            <!--关键是中间设置 layout_width="0dp" 和 layout_weight="1"：左右文字先占用所需宽度，中间再填充剩余空间，文字居中显示。-->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="湿度调控"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:layout_marginEnd="30dp"
                android:text="90"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>